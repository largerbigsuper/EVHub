# EVHub 环境变量配置
# 复制此文件为 .env 并填入实际值

# ====== 数据库 ======
# 本地开发（SQLite，无需安装 PostgreSQL）
DATABASE_URL=sqlite+aiosqlite:///./evhub_dev.db

# 生产环境（PostgreSQL）
# DATABASE_URL=postgresql+asyncpg://ev:ev@localhost:5432/evhub

# ====== Redis ======
# 本地开发（内存模拟，无需安装 Redis）
USE_MEMORY_REDIS=true

# 生产环境
# USE_MEMORY_REDIS=false
# REDIS_URL=redis://localhost:6379/0

# ====== JWT RS256 密钥对 ======
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----
MIIEpAIBAAKCAQEA...
-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
-----END PUBLIC KEY-----

# ====== 文件上传 ======
# UPLOAD_BACKEND: local（本地文件）/ qiniu（七牛云）/ r2（Cloudflare R2，待实现）
UPLOAD_BACKEND=local

# 七牛云 Kodo 配置（UPLOAD_BACKEND=qiniu 时生效）
QINIU_ACCESS_KEY=your_qiniu_access_key
QINIU_SECRET_KEY=your_qiniu_secret_key
QINIU_BUCKET=your_bucket_name
QINIU_DOMAIN=https://cdn.example.com

# 对象存储 (Cloudflare R2，待实现)
R2_BUCKET=evhub-media
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_access_key
R2_SECRET_KEY=your_secret_key

# ====== 全文搜索 (可选) ======
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=local_dev_key

# ====== 错误监控 ======
SENTRY_DSN=

# ====== 邮件 ======
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@evhub.cn
SMTP_PASS=your_smtp_password

# ====== 环境 ======
ENVIRONMENT=development
DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000